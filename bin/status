#!/usr/bin/env bash
set -euo pipefail

################################################################################
# Real World Effect Status
################################################################################
#
# OVERVIEW
# --------
# Show how many apps are available and how many are initialized.
#
# USAGE
# -----
#   bin/status
#
################################################################################

# Colors
green='\033[0;32m'
yellow='\033[1;33m'
nc='\033[0m'

################################################################################
# Main Orchestration
################################################################################

main() {
  show_counts
}

################################################################################
# Helper Functions
################################################################################

log() { echo -e "${green}==>${nc} ${1}"; }
warn() { echo -e "${yellow}==>${nc} ${1}"; }

################################################################################
# Core Functions
################################################################################

has_submodules() {
  [ -f .gitmodules ] && git config --file .gitmodules --name-only --get-regexp '^submodule\..*\.path$' >/dev/null 2>&1
}

show_counts() {
  local submodule_count initialized_count status_output

  submodule_count=0
  initialized_count=0

  if has_submodules; then
    submodule_count=$(git config --file .gitmodules --get-regexp '^submodule\..*\.path$' | wc -l | tr -d ' ')
    status_output=$(git submodule status || true)

    if [ -n "$status_output" ]; then
      initialized_count=$(printf '%s\n' "$status_output" | grep -cv '^-' || true)
    fi
  fi

  log "Real World Effect Status"
  echo "    Configured:  $submodule_count"
  echo "    Initialized: $initialized_count"

  if [ "$submodule_count" -eq "0" ]; then
    warn "No apps configured yet. Run 'bin/add <github-url>' to add your first app."
  elif [ "$initialized_count" -eq "0" ]; then
    warn "No apps initialized yet. Run 'bin/setup' to download all apps."
  elif [ "$initialized_count" -lt "$submodule_count" ]; then
    warn "Some apps not initialized. Run 'bin/setup' to download remaining apps."
  fi
}

################################################################################
# Script Execution
################################################################################

main "$@"
