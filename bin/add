#!/usr/bin/env bash
set -euo pipefail

################################################################################
# Add a Real World Effect App
################################################################################
#
# OVERVIEW
# --------
# Add a new Effect app as a git submodule by GitHub URL. Automatically detects
# the default branch.
#
# USAGE
# -----
#   bin/add <github-url>
#
#   github-url  GitHub repo URL (e.g. https://github.com/user/repo)
#
# EXAMPLES
# --------
#   bin/add https://github.com/example/acme-app
#   bin/add git@github.com:example/acme-api.git
#
################################################################################

# Colors
green='\033[0;32m'
red='\033[0;31m'
nc='\033[0m'

################################################################################
# Main Orchestration
################################################################################

main() {
  parse_arguments "$@"
  check_dependencies
  parse_repo_url
  check_not_exists
  lookup_default_branch
  add_submodule
  show_next_steps
}

################################################################################
# Helper Functions
################################################################################

log() { echo -e "${green}==>${nc} ${1}"; }
error() { echo -e "${red}Error:${nc} ${1}" >&2; exit 1; }

################################################################################
# Core Functions
################################################################################

parse_arguments() {
  if [ -z "${1:-}" ]; then
    echo "Usage: bin/add <github-url>"
    echo ""
    echo "  github-url  GitHub repo URL (e.g. https://github.com/user/repo)"
    echo ""
    echo "Examples:"
    echo "  bin/add https://github.com/example/acme-app"
    echo "  bin/add git@github.com:example/acme-api.git"
    exit 1
  fi

  url="$1"
}

check_dependencies() {
  command -v git >/dev/null 2>&1 || error "git is required"
  command -v gh >/dev/null 2>&1 || error "gh is required"
}

parse_repo_url() {
  repo_path=$(printf '%s\n' "$url" \
    | sed 's|^git@github.com:||' \
    | sed 's|^https://github.com/||' \
    | sed 's|^http://github.com/||' \
    | sed 's|^github.com/||' \
    | sed 's|\.git$||' \
    | sed 's|/$||')

  case "$repo_path" in
    */*) ;;
    *) error "Expected a GitHub repo URL, got '$url'" ;;
  esac

  name=$(basename "$repo_path")
  dest="apps/$name"
  clone_url="https://github.com/${repo_path}.git"
}

check_not_exists() {
  if [ -e "$dest" ]; then
    error "$dest already exists"
  fi
}

lookup_default_branch() {
  log "Looking up default branch for $repo_path..."
  default_branch=$(gh repo view "$repo_path" --json defaultBranchRef -q '.defaultBranchRef.name' 2>/dev/null || true)

  if [ -z "$default_branch" ]; then
    error "Could not find repo $repo_path"
  fi
}

add_submodule() {
  log "Adding $name ($default_branch branch) to $dest..."
  GIT_LFS_SKIP_SMUDGE=1 git submodule add -b "$default_branch" "$clone_url" "$dest"
  log "Added $name to $dest"
}

show_next_steps() {
  echo ""
  echo "Next steps:"
  echo "  1. Add an entry to repos.md"
  echo "  2. Commit and push"
}

################################################################################
# Script Execution
################################################################################

main "$@"
