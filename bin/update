#!/usr/bin/env bash
set -euo pipefail

################################################################################
# Update Real World Effect
################################################################################
#
# OVERVIEW
# --------
# Pull latest changes and update all submodules to their latest remote commits.
#
# USAGE
# -----
#   bin/update
#
################################################################################

# Colors
green='\033[0;32m'
yellow='\033[1;33m'
nc='\033[0m'

################################################################################
# Main Orchestration
################################################################################

main() {
  pull_latest
  update_submodules
  log "All done! Your Real World Effect apps are up to date."
}

################################################################################
# Helper Functions
################################################################################

log() { echo -e "${green}==>${nc} ${1}"; }
warn() { echo -e "${yellow}==>${nc} ${1}"; }

################################################################################
# Core Functions
################################################################################

has_submodules() {
  [ -f .gitmodules ] && git config --file .gitmodules --name-only --get-regexp '^submodule\..*\.path$' >/dev/null 2>&1
}

has_upstream() {
  git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1
}

pull_latest() {
  log "Pulling latest changes..."

  if has_upstream; then
    git pull
  else
    warn "No upstream configured; skipping git pull."
  fi
}

update_submodules() {
  if ! has_submodules; then
    warn "No apps configured yet. Nothing to update."
    return
  fi

  log "Updating all submodules to their latest versions..."
  GIT_LFS_SKIP_SMUDGE=1 git submodule update --remote --jobs 8
}

################################################################################
# Script Execution
################################################################################

main "$@"
